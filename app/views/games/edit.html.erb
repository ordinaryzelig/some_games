<% content_for :title, "Editing game" %>

<div class="game-form-page">
  <div class="game-form-page__topbar">
    <%= link_to @game, class: "game-form-page__back" do %>
      <span aria-hidden="true">←</span> Back to <%= @game.name %>
    <% end %>
  </div>

  <div class="game-form-page__card">
    <h1 class="game-form-page__title">Edit game</h1>
    <p class="game-form-page__subtitle">Update the details for <strong><%= @game.name %></strong>.</p>

    <%= render "form", game: @game %>
  </div>
</div>
