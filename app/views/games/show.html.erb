<% content_for :title, @game.name %>

<div class="game-detail" style="--card-hue: <%= game_hue(@game) %>">
  <div class="game-detail__topbar">
    <%= link_to games_path, class: "game-detail__back" do %>
      <span aria-hidden="true">←</span> Back to all games
    <% end %>

    <div class="game-detail__admin">
      <%= link_to "Edit", edit_game_path(@game), class: "game-detail__admin-link" %>
      <%= button_to "Delete", @game, method: :delete, class: "game-detail__admin-link game-detail__admin-link--danger", form: { data: { turbo_confirm: "Delete this game?" } } %>
    </div>
  </div>

  <div class="game-detail__grid">
    <div class="game-detail__image">
      <%= render "games/game_image", game: @game, variant: "detail" %>
    </div>

    <div class="game-detail__info">
      <h1 class="game-detail__title"><%= @game.name %></h1>

      <div class="game-detail__meta">
        <div class="game-detail__meta-row">
          <span class="game-detail__meta-label">Condition</span>
          <span class="game-detail__meta-value"><%= game_condition_label(@game) %></span>
        </div>

        <div class="game-detail__price"><%= game_price(@game) %></div>
        <div class="game-detail__bids">2 bids</div>

        <%= render "games/payment_icons", variant: "detail" %>
      </div>

      <div class="game-detail__about">
        <h2 class="game-detail__about-heading">About this game</h2>
        <p class="game-detail__about-body">
          <%= @game.name %> is a board game available in <%= game_condition_label(@game).downcase %> condition.
          Browse the listing, review the details, and place a bid to make it yours.
        </p>
      </div>
    </div>
  </div>
</div>

<% if @recommended.any? %>
  <section class="game-detail__related">
    <h2 class="game-detail__related-heading">You might also like</h2>
    <div class="games-grid">
      <%= render @recommended %>
    </div>
  </section>
<% end %>
