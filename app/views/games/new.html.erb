<% content_for :title, "New game" %>

<div class="game-form-page">
  <div class="game-form-page__topbar">
    <%= link_to games_path, class: "game-form-page__back" do %>
      <span aria-hidden="true">←</span> Back to all games
    <% end %>
  </div>

  <div class="game-form-page__card">
    <h1 class="game-form-page__title">Add a game</h1>
    <p class="game-form-page__subtitle">Enter the details for the new listing.</p>

    <%= render "form", game: @game %>
  </div>
</div>
