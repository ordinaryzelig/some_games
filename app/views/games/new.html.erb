<% content_for :title, "Add New Game Listing" %>

<div class="games-page-wrapper">
  <%= render "ambient_glows" %>

  <main class="browse-section">
    <div class="container-custom form-narrow-container">
      <header class="games-header">
        <div class="header-info">
          <h1 class="page-title">Add New Game</h1>
          <p class="page-subtitle">List a premium board game in our marketplace</p>
        </div>
        <div class="header-actions">
          <%= link_to games_path, class: "btn-back-link" do %>
            <span>Back to Marketplace</span>
          <% end %>
        </div>
      </header>

      <div class="form-card-panel">
        <%= render "form", game: @game %>
      </div>
    </div>
  </main>

  <%= render "footer" %>
</div>
