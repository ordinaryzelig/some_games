<%= form_with(model: game, class: "marketplace-form") do |form| %>
  <% if game.errors.any? %>
    <div class="form-errors-alert">
      <h2><%= pluralize(game.errors.count, "error") %> prohibited this game from being saved:</h2>
      <ul>
        <% game.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group-custom">
    <%= form.label :name, "Game Title", class: "form-label-custom" %>
    <%= form.text_field :name, placeholder: "e.g. Dune Imperium Uprising", class: "form-input-custom", required: true %>
  </div>

  <div class="form-group-custom">
    <%= form.label :condition, "Condition", class: "form-label-custom" %>
    <div class="select-wrapper-custom">
      <%= form.select :condition, Game.conditions.keys.map { |k| [k.titleize, k] }, {}, { class: "form-input-custom select-custom" } %>
    </div>
  </div>

  <div class="form-group-custom">
    <%= form.label :price_cents, "Price (in Cents)", class: "form-label-custom" %>
    <%= form.number_field :price_cents, placeholder: "e.g. 28099 for $280.99", class: "form-input-custom", required: true %>
  </div>

  <div class="form-actions-custom">
    <%= form.submit class: "btn-primary-gradient btn-submit-custom" %>
  </div>
<% end %>
