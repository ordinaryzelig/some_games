<%#
  Renders the "Accepts: [icons]" row. Locals:
    variant — "card" or "detail" (controls BEM class prefix)
%>
<% prefix = "game-#{variant}__accepts" %>
<div class="<%= prefix %>">
  <span class="<%= prefix %>-label">Accepts:</span>
  <i class="bi bi-credit-card-2-front" aria-hidden="true"></i>
  <i class="bi bi-paypal" aria-hidden="true"></i>
  <i class="bi bi-currency-bitcoin" aria-hidden="true"></i>
  <i class="bi bi-cash-coin" aria-hidden="true"></i>
  <i class="bi bi-wallet2" aria-hidden="true"></i>
</div>
