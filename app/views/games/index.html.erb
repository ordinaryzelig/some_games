<div class="marketplace-page-wrapper">
  <div class="container-fluid marketplace-container">
    <div class="row g-4">
      <% @games.take(12).each_with_index do |game, index| %>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3 d-flex">
          
          <div class="card premium-game-card border-0 w-100 h-100" style="--animation-order: <%= index %>;">
            
            <div class="card-img-wrapper">
              <%= image_tag "dune.jpg", class: "cinematic-img", alt: game.name %>
            </div>

            <div class="card-body d-flex flex-column">
              <h2 class="game-title fw-bold text-white"><%= game.name %></h2>

              <div class="pricing-section">
                <div class="condition-text"><%= game.condition.to_s.titleize %></div>
                <div class="price-text fw-bold text-white"><%= number_to_currency(game.price_cents / 100.0) %></div>
                <div class="bids-text mb-3">2 bids</div>

                <div class="payment-icons d-flex align-items-center gap-2">
                  <span class="small me-1">Accepts:</span>
                  <i class="bi bi-cash-coin"></i>
                  <i class="bi bi-stripe"></i>
                  <i class="bi bi-paypal"></i>
                  <i class="bi bi-currency-bitcoin"></i>
                </div>
              </div>

            </div>
          </div>

        </div>
      <% end %>
    </div>
  </div>
</div>

<footer class="custom-premium-footer">
  
  <div class="footer-hero-graphic">
    <%= image_tag "image.png", alt: "Turnip Cake 3D Element", class: "floating-cube" %>
  </div>

  <div class="footer-content-wrapper">
    <div class="footer-top-row">
      
      <div class="footer-brand">
        <i class="bi bi-layers fs-3"></i>
        <span class="brand-name">TURNIP CAKE</span>
      </div>

      <div class="footer-btn-container">
        <button class="footer-action-btn">Find events near you</button>
      </div>

      <nav class="footer-links">
        <a href="#">About</a>
        <a href="#">Support</a>
        <a href="#">Privacy Policy</a>
      </nav>
      
    </div>

    <div class="footer-social-row">
      <a href="#" class="social-icon"><i class="bi bi-facebook"></i></a>
      <a href="#" class="social-icon"><i class="bi bi-instagram"></i></a>
      <a href="#" class="social-icon"><i class="bi bi-twitter-x"></i></a>
    </div>
  </div>

</footer>