<% content_for :title, "Games" %>

<% if notice.present? %>
  <p class="alert alert-success" role="alert"><%= notice %></p>
<% end %>

<main class="games-page">
  <div class="container-fluid px-4">

    <div class="games-grid">
      <% @games.each do |game| %>
        <%= render game %>
      <% end %>
    </div>

  </div>
</main>
