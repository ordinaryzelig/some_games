<% content_for :title, "Games" %>

<% if notice.present? %>
  <p class="flash-notice"><%= notice %></p>
<% end %>

<main class="games-page">
  <div class="games-page__glow games-page__glow--left" aria-hidden="true"></div>
  <div class="games-page__glow games-page__glow--right" aria-hidden="true"></div>

  <div class="games-grid" id="games">
    <% @games.each do |game| %>
      <%= render game %>
    <% end %>
  </div>
</main>
