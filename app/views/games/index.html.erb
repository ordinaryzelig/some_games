<% content_for :title, "Games" %>

<main class="games-page">
  <div class="container">
    <h1 class="visually-hidden">Games</h1>

    <% if notice.present? %>
      <p class="games-page__notice" role="status"><%= notice %></p>
    <% end %>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xxl-4 gx-3 gy-5">
      <%= render partial: "game_card", collection: @games, as: :game %>
    </div>
  </div>
</main>
