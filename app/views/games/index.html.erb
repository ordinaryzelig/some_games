<% content_for :title, "Games" %>

<% if notice.present? %>
  <p class="flash-notice"><%= notice %></p>
<% end %>

<main class="container-xl py-5">
  <h1 class="visually-hidden">Games</h1>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4" id="games">
    <%= render @games %>
  </div>
</main>
