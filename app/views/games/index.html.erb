<% if notice %>
  <p class="notice"><%= notice %></p>
<% end %>

<% content_for :title, "Games" %>

<div class="games-header">
  <h1>Games</h1>
  <%= link_to "New game", new_game_path, class: "new-game-btn" %>
</div>

<div class="games-container" id="games">
  <% @games.each do |game| %>
    <div class="game-wrapper">
      <%= link_to game do %>
        <%= render game %>
      <% end %>
    </div>
  <% end %>
</div>
