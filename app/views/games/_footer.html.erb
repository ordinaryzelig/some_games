<footer class="app-footer">
  <div class="footer-container">
    <div class="footer-main-row">
      <!-- Left Column: Logo -->
      <div class="footer-col-left">
        <div class="logo-turnip-cake">
          <%= image_tag "board_game_images/LOGO White.png", style: "height: 32px; width: auto;", alt: "Turnip Cake Logo" %>
        </div>
      </div>

      <!-- Center Column: Cube + Button -->
      <div class="footer-col-center">
        <div class="logo-glass-container">
          <div class="cube-glow-underlay"></div>
          <%= image_tag "board_game_images/box-image.png", class: "footer-box-image", alt: "Turnip Cake centerpiece" %>
        </div>
        
        <a href="#" class="btn-find-events">
          <span>Find events near you</span>
        </a>
      </div>

      <!-- Right Column: Menu Links -->
      <div class="footer-col-right">
        <nav class="footer-menu-block" aria-label="Footer Navigation">
          <a href="#" class="footer-menu-link">About</a>
          <a href="#" class="footer-menu-link">Support</a>
          <a href="#" class="footer-menu-link">Privacy Policy</a>
        </nav>
      </div>
    </div>

    <!-- Bottom Row: Social Icons -->
    <div class="footer-bottom-row">
      <div class="footer-social-icons">
        <!-- FACEBOOK -->
        <a href="#" class="social-icon-circle" aria-label="Facebook">
