<header class="site-header">
  <div class="site-container site-header__inner">
    <%= link_to games_path, class: "brand", "aria-label": "Turnip Cake" do %>
      <%= image_tag "ui/logo-dark.png", alt: "Turnip Cake", class: "brand__logo" %>
    <% end %>

    <button class="site-nav__toggle" type="button"
            data-bs-toggle="collapse" data-bs-target="#siteNav"
            aria-controls="siteNav" aria-expanded="false" aria-label="Toggle navigation">
      <i class="bi bi-list" aria-hidden="true"></i>
    </button>

    <nav class="site-nav collapse" id="siteNav" aria-label="Primary">
      <ul class="site-nav__links">
        <li><a href="#">Sell</a></li>
        <li><a href="#">Faqs</a></li>
        <li><a href="#">Pricing</a></li>
        <li><a href="#">Log In</a></li>
      </ul>

      <div class="site-nav__icons">
        <a href="#" class="site-nav__icon" aria-label="Notifications"><i class="bi bi-bell" aria-hidden="true"></i></a>
        <a href="#" class="site-nav__icon" aria-label="Find events near you"><i class="bi bi-geo-alt" aria-hidden="true"></i></a>
        <a href="#" class="site-nav__icon site-nav__cart" aria-label="Cart">
          <i class="bi bi-cart" aria-hidden="true"></i>
          <span class="site-nav__qty">2</span>
        </a>
      </div>
    </nav>
  </div>
</header>
