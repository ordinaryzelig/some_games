<footer class="site-footer pb-4">
  <div class="offset-figure container-lg">
    <%= image_tag 'Logo_GLASS.png', class: 'logo-glass', alt: 'Logo Glass' %>
  </div>
  <div class="container-lg">
    <nav class="footer-nav row gy-3 align-items-center">
      <div class="col-12 col-lg-auto">
        <a class="footer-nav-brand" href="/">
          <%= image_tag 'brand.svg', alt: 'Turnip Cake', style: 'filter: invert(1)' %>
        </a>
      </div>
      <div class="footer-nav-menu navbar-nav col-12 col-lg-auto flex-column flex-lg-row ms-lg-auto">
        <%= link_to "About", "#", class: "nav-link ps-3" %>
        <%= link_to "Support", "#", class: "nav-link ps-3" %>
        <%= link_to "Privacy Policy", "#", class: "nav-link ps-3" %>
      </div>
    </nav>
  </div>
  <div class="container-lg d-flex flex-row justify-content-center mb-5">
    <%= link_to "Find events near you", '#', class: 'btn btn-primary border-0 fw-medium footer-action-btn' %>
  </div>
  <div id="footer-socials" class="container-lg d-flex flex-row justify-content-center mb-3">
    <% %w(facebook instagram x).each do |social| %>
      <%= link_to "#", class: 'footer-social-link' do %>
        <%= image_tag "social_icons/#{social}.svg", alt: social %>
      <% end %>
    <% end %>
  </div>
</footer>
