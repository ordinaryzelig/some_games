<dialog id="custom-confirm-dialog" class="confirm-dialog" aria-labelledby="confirm-dialog-title">
  <div class="confirm-dialog__inner">
    <div class="confirm-dialog__icon" aria-hidden="true">
      <i class="bi bi-exclamation-triangle-fill"></i>
    </div>
    <h2 id="confirm-dialog-title" class="confirm-dialog__title">Are you sure?</h2>
    <p class="confirm-dialog__message" data-confirm-message></p>
    <form method="dialog" class="confirm-dialog__actions">
      <button type="submit" value="cancel" class="confirm-dialog__btn confirm-dialog__btn--secondary">
        Cancel
      </button>
      <button type="submit" value="confirm" class="confirm-dialog__btn confirm-dialog__btn--danger" autofocus>
        Delete
      </button>
    </form>
  </div>
</dialog>
