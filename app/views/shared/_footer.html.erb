<footer class="site-footer">
  <div class="site-footer__top-glow" aria-hidden="true"></div>

  <div class="site-footer__cube-area">
    <div class="site-footer__cube-wrap">
      <%= image_tag "footer-cube.png", alt: "", class: "site-footer__cube", aria: { hidden: true } %>
      <div class="site-footer__cube-shadow" aria-hidden="true"></div>
    </div>
  </div>

  <div class="site-footer__body">
    <div class="site-footer__top">
      <a href="#" class="site-footer__brand">
        <%= image_tag "turnip-cake-logo.svg", alt: "", class: "site-footer__brand-icon", aria: { hidden: true } %>
        <span class="site-footer__brand-name">Turnip cake</span>
      </a>

      <nav class="site-footer__nav" aria-label="Footer">
        <a href="#">About</a>
        <a href="#">Support</a>
        <a href="#">Privacy Policy</a>
      </nav>
    </div>

    <div class="site-footer__center">
      <a href="#" class="site-footer__cta">Find events near you</a>

      <div class="site-footer__follow" aria-label="Follow us">
        <a href="#" class="site-footer__follow-link" aria-label="Facebook">
          <i class="bi bi-facebook"></i>
        </a>
        <a href="#" class="site-footer__follow-link" aria-label="Instagram">
          <i class="bi bi-instagram"></i>
        </a>
        <a href="#" class="site-footer__follow-link" aria-label="X">
          <i class="bi bi-twitter-x"></i>
        </a>
      </div>
    </div>
  </div>
</footer>
