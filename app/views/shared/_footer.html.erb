<footer class="site-footer">
  <%= image_tag "turnip_cake_cube.png", alt: "", class: "site-footer__cube" %>

  <div class="site-footer__row">
    <div class="site-footer__brand">
      <%= image_tag "turnip_cake_logo.png", alt: "Turnip Cake" %>
    </div>

    <div class="site-footer__center">
      <%= link_to "Find events near you", "#", class: "site-footer__cta" %>
    </div>

    <nav class="site-footer__links" aria-label="Footer">
      <%= link_to "About", "#" %>
      <%= link_to "Support", "#" %>
      <%= link_to "Privacy Policy", "#" %>
    </nav>
  </div>

  <div class="site-footer__social">
    <%= link_to "#", "aria-label": "Facebook", class: "site-footer__social-fb" do %>
      <svg viewBox="0 0 320 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="site-footer__social-fb-svg">
        <path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/>
      </svg>
    <% end %>
    <%= link_to "#", "aria-label": "Instagram" do %><i class="bi bi-instagram"></i><% end %>
    <%= link_to "#", "aria-label": "X" do %><i class="bi bi-twitter-x"></i><% end %>
  </div>
</footer>
